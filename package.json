{
  "name": "smart-cookbook",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "validate:yaml": "node scripts/validate-yaml.js",
    "validate:schema": "node scripts/validate-schema.js",
    "validate:recipes": "node scripts/validate-recipes.js",
    "check:index": "node scripts/check-index.js",
    "index:recipes": "node scripts/generate-index.js",
    "test:unit": "node --test tests/*.test.js",
    "lint:html": "html-validate \"**/*.html\"",
    "test:a11y": "node scripts/ci-a11y.js",
    "scan:security": "node scripts/ci-security.js",
    "quality": "npm run validate:yaml && npm run validate:schema && npm run validate:recipes && npm run check:index && npm run test:unit && npm run lint:html && npm run test:a11y && npm run scan:security"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.43.0",
    "ajv": "^8.20.0",
    "html-validate": "^11.18.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^24.0.0"
  }
}
